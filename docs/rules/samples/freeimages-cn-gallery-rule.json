{
  "version": "1.0",
  "meta": {
    "siteId": "freeimages-cn-gallery",
    "siteName": "FreeImages 中文图库",
    "baseUrl": "https://www.freeimages.com",
    "contentType": "gallery"
  },
  "request": {
    "method": "GET",
    "charset": "utf-8",
    "timeoutMs": 15000,
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/123.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8",
      "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8",
      "Cache-Control": "no-cache",
      "Pragma": "no-cache",
      "Referer": "https://www.freeimages.com/cn/",
      "Upgrade-Insecure-Requests": "1"
    }
  },
  "routes": {
    "indexUrl": "https://www.freeimages.com/cn/search/cat/2",
    "detailUrlMode": "direct"
  },
  "indexRule": {
    "item": {
      "selector": ".grid-item article.grid-article"
    },
    "fields": {
      "title": {
        "selector": "img.grid-thumb",
        "function": "attr",
        "param": "alt",
        "regex": "\\\\s*免费图库.*$",
        "replacement": "",
        "trim": true
      },
      "detailUrl": {
        "selector": "a.grid-link",
        "function": "attr",
        "param": "href",
        "absoluteUrl": true
      },
      "cover": {
        "selector": "img.grid-thumb",
        "function": "attr",
        "param": "src",
        "absoluteUrl": true
      }
    }
  },
  "detailRule": {
    "item": {
      "selector": "html"
    },
    "fields": {
      "title": {
        "selector": "#photo-title",
        "function": "text",
        "trim": true
      },
      "url": {
        "selector": "link[rel='canonical']",
        "function": "attr",
        "param": "href",
        "absoluteUrl": true
      }
    }
  },
  "contentRule": {
    "images": {
      "item": {
        "selector": "#photo-wrapper img#photo"
      },
      "fields": {
        "url": {
          "selector": "",
          "function": "attr",
          "param": "src",
          "absoluteUrl": true
        }
      }
    }
  }
}
